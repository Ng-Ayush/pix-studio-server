{
  "name": "pix-studio-pro",
  "version": "1.0.0",
  "description": "Professional image management and sharing platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start-electron": "electron .",
    "dev": "npx concurrently -k \"npm run serve\" \"wait-on -t 60000 http://localhost:4200 && electron .\"",
    "build": "npm run build:angular && electron-builder",
    "ng": "ng",
    "serve": "cd pix-studio-pro && ng serve",
    "build:angular": "cd pix-studio-pro && ng build --configuration production",
    "watch": "cd pix-studio-pro && ng build --watch --configuration development"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "twilio": "^5.5.2",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.12",
    "@angular/cli": "^17.3.12",
    "@angular/compiler-cli": "^17.3.0",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.3.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.6.4",
    "typescript": "~5.4.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pixstudio.pro",
    "productName": "Pix Studio Pro",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "server.js",
      ".env"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "extraResources": [
      {
        "from": "pix-studio-pro/dist/pix-studio-pro",
        "to": "pix-studio-pro/dist/pix-studio-pro",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
